#!/usr/bin/expect -f

set retval 0
set loginUser "pi"
set loginPassword "raspberry"
set prompt "pi@raspberrypi:~\\$ "

# Fail instead of waiting forever when the guest stops responding
proc waitPrompt {} {
  global prompt
  expect {
    -re $prompt {}
    timeout { puts "\nTest failed: timed out waiting for shell prompt."; exit 1 }
    eof { puts "\nTest failed: QEMU exited unexpectedly."; exit 1 }
  }
}

spawn qemu-system-aarch64 -machine "raspi3b" -cpu cortex-a53 -m 1G -drive "format=raw,file=raspios.img" -dtb "./custom.dtb" -kernel "./tests/kernel/kernel8.img" -append "loglevel=0 quiet console=ttyAMA0,115200 root=/dev/mmcblk0p2 rootfstype=ext4 fsck.repair=yes rootwait" -nographic -serial mon:stdio

# Login process
set timeout 600
expect {
  "raspberrypi login: " {
    send "$loginUser\r"
    exp_continue
  }
  "Password: " {
    send "$loginPassword\r"
    exp_continue
  }
  "Login incorrect" {
    puts "\nTest failed: login incorrect."
    exit 1
  }
  -re $prompt {
    send "sudo date -s \"DATESED\"\r"
  }
  timeout {
    puts "\nTest failed: timed out waiting for login."
    exit 1
  }
  eof {
    puts "\nTest failed: QEMU exited during startup."
    exit 1
  }
}

# Install tests
waitPrompt
set timeout 3600
send "sudo /opt/zram-config/install.bash\r"
waitPrompt
set timeout 600
send "/opt/zram-config/tests/test-zram-devices.bash\r"
expect {
  -re "Test failed:.*$" {
    set retval 1
    exp_continue
  }
  -re $prompt {
    send "sudo touch /var/log/test\r"
  }
  timeout { puts "\nTest failed: timed out running install tests."; exit 1 }
  eof { puts "\nTest failed: QEMU exited during install tests."; exit 1 }
}

# Uninstall tests
waitPrompt
send "sudo /opt/zram-config/uninstall.bash\r"
waitPrompt
send "/opt/zram-config/tests/test-zram-devices.bash removal\r"
expect {
  -re "Test failed:.*$" {
    set retval 1
    exp_continue
  }
  -re $prompt {
    send "sync\r"
  }
  timeout { puts "\nTest failed: timed out running uninstall tests."; exit 1 }
  eof { puts "\nTest failed: QEMU exited during uninstall tests."; exit 1 }
}

# Shutdown
waitPrompt
send "sudo shutdown -h now\r"
expect {
  eof {}
  timeout { puts "\nTest failed: timed out waiting for shutdown."; exit 1 }
}

exit $retval
